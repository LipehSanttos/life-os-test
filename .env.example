# ==============================================================================
# Life OS - Variáveis de Ambiente Necessárias em Produção (Cloudflare / Vercel)
# ==============================================================================

# Conexão com o Supabase (Painel do Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Segredo para assinatura de tokens de sessão (mínimo 16 caracteres aleatórios)
AUTH_SECRET=gere_uma_chave_aleatoria_com_mais_de_16_caracteres

# Banco de dados Prisma / PostgreSQL (se aplicável)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?schema=public
DIRECT_URL=postgresql://usuario:senha@host:5432/banco?schema=public

# Provedores de Inteligência Artificial (Opcional - podem ser configurados pelo painel Settings)
GEMINI_API_KEY=
GROQ_API_KEY=
